# SmartX 行情后端。测试期地址会变，复制为 .env.local 后按需修改（docs/api/market.md §0）
NEXT_PUBLIC_MARKET_API_BASE=http://13.52.177.63:8080
# WS 默认走同源 /market-api/ws 转发（直连会被网关按 Origin 拒绝 403，见 lib/market.ts getWsUrl）。
# 仅当后端放开浏览器 Origin 后才配置直连地址：
# NEXT_PUBLIC_MARKET_WS_URL=wss://be-test-api.smartx.io/ws

# ===== 登录域（privy-login-demo 迁移，docs/privy-login/）=====

# Privy 应用 id。必须与后端 configs/business.yaml 的 privy.app_id 逐字符一致，
# 对不上时登录一律 400100。
NEXT_PUBLIC_PRIVY_APP_ID=cmt77j1bz00870cjorav46hyb

# Privy App client id（Dashboard → Clients）。可选，留空即不传；
# 空串会被当成真实 client id 校验然后失败，所以留空要真的留空。
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# 用户域后端（Node 侧，next.config.ts 的 /v1 代理目标）。浏览器一律打相对路径
# /v1（同源代理绕 CORS）。改完必须重启 dev server。
BUSINESS_ORIGIN=http://13.231.246.26:8080

# 同一个地址给浏览器看：页面显示"当前后端"、生成 curl、以及记住
# "这个 token 是哪个后端签的"。
NEXT_PUBLIC_BUSINESS_ORIGIN_LABEL=http://13.231.246.26:8080

# 第三方登录硬闸（默认关）。Privy 控制台对应开关也要开，两道闸都开才生效。
NEXT_PUBLIC_ENABLE_GOOGLE=false
NEXT_PUBLIC_ENABLE_APPLE=false
