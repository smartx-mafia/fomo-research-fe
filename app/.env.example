# SmartX 行情后端。测试期地址会变，复制为 .env.local 后按需修改（docs/api/market.md §0）
NEXT_PUBLIC_MARKET_API_BASE=https://sm-test-api.smartx.io
# 默认根据上面的 HTTP 地址生成 wss://sm-test-api.smartx.io/ws；需要独立地址时覆盖：
# NEXT_PUBLIC_MARKET_WS_URL=wss://sm-test-api.smartx.io/ws

# ===== 登录域（privy-login-demo 迁移，docs/privy-login/）=====

# Privy 应用 id。必须与后端 configs/business.yaml 的 privy.app_id 逐字符一致，
# 对不上时登录一律 400100。
NEXT_PUBLIC_PRIVY_APP_ID=cmt77j1bz00870cjorav46hyb

# Privy App client id（Dashboard → Clients）。可选，留空即不传；
# 空串会被当成真实 client id 校验然后失败，所以留空要真的留空。
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# Embedded Solana wallet signing requires an explicit mainnet RPC. Use a browser-allowed endpoint;
# this value is public in the client bundle, so do not place privileged server credentials here.
NEXT_PUBLIC_SOLANA_RPC_URL=

# Crossmint Embedded Checkout public browser key. Never place a server key or order client_secret here.
NEXT_PUBLIC_CROSSMINT_CLIENT_SIDE_API_KEY=

# 浏览器直连的用户/社交/交易 API。必须公开可达、使用 HTTPS 并允许前端 Origin。
# 页面显示、DevTools 请求和登录 token 的签发来源都使用这一处配置。
NEXT_PUBLIC_BUSINESS_API_BASE=https://sm-test-api.smartx.io

# 第三方登录硬闸（默认关）。Privy 控制台对应开关也要开，两道闸都开才生效。
NEXT_PUBLIC_ENABLE_GOOGLE=false
NEXT_PUBLIC_ENABLE_APPLE=false

# ===== harness（内部调试工具，docs/harness/）=====

# /dev/harness 页面总开关。必须显式为字符串 true 才开启；
# 未设置或任何其他值一律渲染 not-found（404），harness 代码也不会下发到浏览器。
# 产品环境保持关闭。
NEXT_PUBLIC_ENABLE_HARNESS=false

# harness 的「本机」档 Privy 应用 id。**这个值不是凭据**（它出现在每个浏览器的
# 网络面板里），可以入库示例；app_secret 绝不出现在前端。
# 与上面产品域的 NEXT_PUBLIC_PRIVY_APP_ID 是两回事：harness 可以对着另一个 app 跑。
NEXT_PUBLIC_HARNESS_PRIVY_APP_ID=

# harness「测试环境」那一档的**总开关**：不配就用不了，顶栏上那一档禁用并写明
# 缺哪个变量（不静默隐藏——消失了的开关无法与「这个版本没这功能」区分）。
# 取自测试机 configs/business.yaml 的 privy.app_id。它与上面那个是**两套用户、
# 两套钱包**：同一个邮箱在两边是两个人，地址不同。填串的症状是登录一律 400100
# —— 那个码指向 identity token，看起来像 Privy 出了问题。
NEXT_PUBLIC_HARNESS_TEST_PRIVY_APP_ID=

# harness 自己的 Privy App client id（Dashboard → Clients）。可选，留空即不传；
# 空串会被当成真实 client id 去校验然后失败，所以留空要真的留空。
# 与产品域的 NEXT_PUBLIC_PRIVY_CLIENT_ID 是两回事：harness 对着另一个 app 跑，
# client id 是挂在 app 上的，拿错那个的症状是 Privy 直接拒登。
# **两档环境共用这一个值**（源仓库就是这样：它读的是单个变量，不随环境切换）——
# 也就是说测试环境那一档配了 client id 就必须两边同号，否则别配。
NEXT_PUBLIC_HARNESS_PRIVY_CLIENT_ID=

# 顶栏上两档各自叫什么。不配就是「本机」/「测试环境」。
# 默认档的名字可配：部署在 smartx-test 上的那一份，同源打到的**就是**测试环境的
# business，那儿写「本机」是假的。
NEXT_PUBLIC_HARNESS_ENV_LABEL=
NEXT_PUBLIC_HARNESS_TEST_ENV_LABEL=

# 后端地址，**只给人看**：顶栏 title 与报障模板，从不参与发请求。
# 真正打到哪儿由 BUSINESS_ORIGIN / TEST_BUSINESS_ORIGIN（无 NEXT_PUBLIC_ 前缀，
# 只有代理读）决定。两边应当一致但**没有任何机制保证** —— 所以宁可留空显示
# 「不知道」，也不要填一个过时的值：报障时「哪个后端」是第一个要问的问题，
# 而切过后端之后旧 token 必然 400000，标签写错的人会去怀疑 JWT 验签，方向整个反掉。
NEXT_PUBLIC_HARNESS_BUSINESS_LABEL=
NEXT_PUBLIC_HARNESS_TEST_BUSINESS_LABEL=

# 「服务端代签授权」那两个按钮要挂上去的 key quorum id（给 Node 侧脚本用；
# 页面下单一律在浏览器里自己签）。不配就把按钮禁掉并把变量名写在旁边。
# 怎么来：
#   1. openssl ecparam -name prime256v1 -genkey -noout -out private.pem
#   2. Privy 控制台 → Authorization keys → New key → **Register key quorum
#      instead**，阈值 1-of-1，拿到 key quorum id 填在这里
#   3. private.pem 留在本机，**绝不进这个文件、不进版本库**
# **一个环境一个**：key quorum 建在 Privy app 上，而两套环境是两个 app，
# 拿错的症状是授权请求被 Privy 拒掉，而错误文案指向 Privy。
NEXT_PUBLIC_HARNESS_KEY_QUORUM_ID=

# ----- dev 代理的目标后端（src/app/api/harness/proxy/，仅 next dev 生效）-----
# 这三个**没有 NEXT_PUBLIC_ 前缀**：只有服务端的代理代码读，不进浏览器 bundle。
# 生产构建不读它们（代理整支被排除，见 next.config.ts 的长注释）。
# 全部可留空，留空即用代码里的默认值。

# 「本机」档打到哪个 business。默认 http://127.0.0.1:8080
BUSINESS_ORIGIN=

# 「测试环境」档打到哪个 business。默认 https://sm-test-api.smartx.io
TEST_BUSINESS_ORIGIN=

# Fast Swap v2 的独立进程 sx_fastswap。默认 http://127.0.0.1:8082
# 注意本机还必须同时起 sx_fastswap_worker，否则 swap 永远走不到终态。
# 想打测试环境的 fastswap 就指到 https://sm-test-api.smartx.io ——
# 它对任何带 Origin 的请求回裸 403 "origin not allowed"，所以浏览器直连一定失败，
# 必须经代理（代理会把 Origin 摘掉）。
FASTSWAP_ORIGIN=

# ----- harness 的 Node 侧 CLI 脚本（scripts/harness/，用 pnpm run harness:*）-----
# 同样**没有 NEXT_PUBLIC_ 前缀**，只在 Node 进程里读，与页面无关。

# 只读延迟探针 harness:probe —— GET /v1/meme/chains + GET /v1/portfolio
# 注意：测试环境上**这两个端点都要 bearer**，不是只有 portfolio 要。
HARNESS_API_ORIGIN=
# 本站 JWT，用后端仓 scripts/devtoken 对目标环境的私钥签。签错环境的症状是 400000。
HARNESS_TOKEN=

# 标的名单采样 harness:universe —— 无鉴权拉 5 个 board，去重、过流动性门槛、分层
# 输出路径。默认 .harness-out/universe.json。
# **不要改成 out/**：那是 next build 的静态导出目录，每次构建被整个重写，名单会被静默删掉。
HARNESS_OUT=
HARNESS_MIN_LIQUIDITY=   # 默认 5000（USD）
HARNESS_TIERS=           # 默认 3
HARNESS_PER_TIER=        # 默认 33（Solana 每档取几个；BSC 全取）

# ----- Privy 服务端代签 harness:privy-sign -----
# ⚠ 私钥审批线。这组变量等同于**对所有已授权钱包的代签权**。
# 这里只登记名字，**不要在任何 .env* 文件里填值** —— 那是一份躺在磁盘上的明文。
# 要用就在命令行前缀里临时给：PRIVY_APP_ID=... pnpm run harness:privy-sign
# CI 上不要跑这个脚本。
PRIVY_APP_ID=            # 与页面当前环境那个 app id 一致
PRIVY_APP_SECRET=        # Privy 控制台的 app secret
PRIVY_AUTHZ_KEY=         # P-256 授权私钥的**文件路径**（支持 ~/ 开头），不是私钥本身
PRIVY_AUTHZ_KEY_PEM=     # 一般不用手填：脚本从 PRIVY_AUTHZ_KEY 指的文件读出 PEM 后注入
PRIVY_EVM_WALLET_ID=     # 可选，给了才验 EVM
PRIVY_EVM_ADDRESS=       # 可选，与上一条成对，用于 ecrecover 回验
PRIVY_SOL_WALLET_ID=     # 可选，给了才验 Solana
PRIVY_API_BASE=          # 可选，默认 https://api.privy.io；staging 走 https://api.staging.privy.io
